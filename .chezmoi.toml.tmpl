{{- $name := promptStringOnce . "name" "Name" -}}
{{- $email := promptStringOnce . "email" "Email address" -}}
{{- $windowManager := promptChoiceOnce . "windowManager" "Window Manager"  (list "none" "hyprland" "i3") -}}

[data]
    email = {{ $email |quote }} 
    name = {{ $name | quote }} 
    windowManager = {{ $windowManager | quote }} 
