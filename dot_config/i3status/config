general {
    colors = true
    interval = 1
    color_good = "#a6e3a1"
    color_bad = "#f38ba8"
    color_degraded = "#f9e2af"
}

order += "wireless _first_"
order += "cpu_usage"
order += "memory"
order += "disk /"
order += "tztime local"
order += "battery all"

wireless _first_ {
    format_up = "WiFi: %quality at %essid %bitrate"
    format_down = "WiFi: down"
}

cpu_usage {
    format = "CPU: %usage"
}

memory {
    format = "RAM: %used"
}

disk "/" {
    format = "DISK: %avail"
}

tztime local {
    format = "%H:%M %d-%m-%Y "
}

battery all {
        format = "%status %percentage" 
        format_down = "No battery"
        status_chr = "⚡ CHR"
        status_bat = "🔋 BAT"
        status_unk = "? UNK"
        status_full = "☻ FULL"
        path = "/sys/class/power_supply/BAT%d/uevent"
        low_threshold = 10
}
