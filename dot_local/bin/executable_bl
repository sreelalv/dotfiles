#!/usr/bin/env bash

bl() {
  local cache="/tmp/bluetooth.devices" opt OPTIND=1

  command -v bluetoothctl >/dev/null || {
    echo "bluetoothctl is not installed!" >&2
    return 1
  }
  systemctl --quiet is-active bluetooth || {
    echo -e "Bluetooth service is not active\nPlease enable/install bluetooth" >&2
    return 1
  }

  _bl_list() {
    bluetoothctl devices | awk '{n=$1=""; print NR, $2, substr($0, index($0,$3))}' | tee "$cache"
  }
  _bl_mac() {
    [[ -f $cache ]] || _bl_list >/dev/null
    awk -v id="$1" '$1 == id {print $2}' "$cache"
  }
  _bl_need() {
    local mac
    mac=$(_bl_mac "$1")
    [[ -n $mac ]] || {
      echo "Unknown device ID: $1 (run bl -l)" >&2
      return 1
    }
    echo "$mac"
  }

  usage() {
    cat <<'EOF'
Usage: bl [-i] [-s] [-l] [-c ID] [-C] [-d ID] [-r ID] [-R] [-e] [-D] [-h]

  -i        bluetoothctl interactive
  -s        Scan (5s) and list devices
  -l        List known devices
  -c <ID>   Connect (pairs/trusts if needed)
  -C        Show connected devices
  -d <ID>   Disconnect device
  -r <ID>   Remove/forget device
  -R        Remove/forget all devices
  -e        Enable bluetooth (rfkill unblock)
  -D        Disable bluetooth (rfkill block)
  -h        Help
EOF
  }

  [[ $# -eq 0 ]] && {
    usage
    return 0
  }

  if rfkill list bluetooth | grep -q 'Soft blocked: yes' && [[ $1 != -[ehiD] ]]; then
    echo -e "Bluetooth is blocked\nbl -e  - to unblock" >&2
    return 1
  fi

  bluetoothctl show | grep -Eq 'PowerState: off|Powered: no' && bluetoothctl power on >/dev/null

  local mac
  while getopts ':islc:Cd:r:ReDh' opt; do
    case $opt in
    i) bluetoothctl ;;
    s)
      bluetoothctl --timeout 5 scan on >/dev/null 2>&1
      _bl_list
      ;;
    l) _bl_list ;;
    c)
      mac=$(_bl_need "$OPTARG") || return 1
      bluetoothctl info "$mac" | grep -q 'Trusted: yes' ||
        { bluetoothctl pair "$mac" && bluetoothctl trust "$mac"; } >/dev/null
      if bluetoothctl connect "$mac" >/dev/null; then
        echo "Connection successful"
      else
        echo "Connection failed" >&2
        return 1
      fi
      ;;
    C) bluetoothctl devices Connected ;;
    d)
      mac=$(_bl_need "$OPTARG") || return 1
      echo "Disconnecting $mac..."
      bluetoothctl disconnect "$mac" >/dev/null
      ;;
    r)
      mac=$(_bl_need "$OPTARG") || return 1
      echo "Removing $mac"
      bluetoothctl remove "$mac" >/dev/null
      ;;
    R)
      while read -r _ mac _; do
        echo "Removing $mac"
        bluetoothctl remove "$mac" >/dev/null
      done < <(bluetoothctl devices)
      : >"$cache"
      ;;
    e) rfkill unblock bluetooth ;;
    D) rfkill block bluetooth ;;
    h) usage ;;
    :)
      echo "Option -$OPTARG needs an argument" >&2
      return 1
      ;;
    *)
      usage
      return 1
      ;;
    esac
  done
}

bl "$@"
