#!/usr/bin/env bash

aria_help() {
  cat <<'EOF'
Usage: aria [-s URI|MAGNET|TORRENT] [-o FILE] [-d DIR] [-D DIR] [-p]

Options:
  -s <URI>    The source url
  -o <FILE>   The output file name
  -d <DIR>    Current download path
  -D <DIR>    Change the default download path
  -p          View the default download path
EOF
}

aria() {
  local url
  local output
  local dir

  local _aria_="aria2c -x 16 -s 16 -j 8"
  local torrent="--enable-dht=true --bt-enable-lpd=true --bt-max-peers=50 --seed-time=0"

  _ariadir() {
    local path="$HOME/.local/.aria_path"
    if [[ -n "$1" ]]; then
      if [[ $(command -v realpath) ]]; then
        realpath $1 | tee $path
      else
        echo "Realpath : command not found"
      fi
    else
      if [[ -f $path ]]; then
        cat $path
      else
        echo "$HOME/Downloads/aria"
      fi
    fi
  }

  _dir() {
    dir="$1"
  }

  _url() {
    url="$1"
  }

  _output() {
    local arg="$1"
    _aria_="${_aria_} -o ${arg}"
  }

  while getopts ':s:o:d:D:ph' opts; do
    case "$opts" in
    s) _url "$OPTARG" ;;
    o) _output "$OPTARG" ;;
    d) _dir "$OPTARG" ;;
    D) _ariadir "$OPTARG" ;;
    p) _ariadir ;;
    h)
      aria_help
      exit 0
      ;;
    :)
      printf 'Error: option -%s requires an argument\n' "$OPTARG" >&2
      exit 2
      ;;
    \?)
      printf 'Error: option -%s is invalid\n' "$OPTARG" >&2
      aria_help
      exit 1
      ;;
    esac
  done
  shift $((OPTIND - 1))

  if [[ "${url:=$1}" =~ torrent$ || "${url:=$1}" =~ ^magnet ]]; then
    _aria_="${_aria_} ${torrent}"
  fi

  if [[ -z "$dir" ]]; then
    if [[ -f "$HOME/.local/.aria_path" ]]; then
      read dir <"$HOME/.local/.aria_path"
      dir="-d ${dir}"
    else
      dir="-d $HOME/Downloads/aria/"
    fi
  else
    dir="-d ${dir}"
  fi

  _aria_="${_aria_} ${dir}"

  if [[ -n "$url" ]]; then
    $_aria_ "$url"
  fi
}

aria "$@"
