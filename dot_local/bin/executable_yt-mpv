#!/usr/bin/env bash

comment=""
mpv_entry() {
  comment="$(zenity --forms \
    --title='mpv' \
    --text='' \
    --add-entry='Name')" || exit
}

while getopts "c" opts; do
  case "$opts" in
  c) mpv_entry ;;
  \?) printf 'Error: option -%s is invalid\n' "$OPTARG" >&2 ;;
  esac
done
shift $((OPTIND - 1))

url=$(~/.local/bin/getit)

[[ -z "$url" ]] && exit

[[ -n "$comment" ]] && printf "%s|%s\n" "$comment" "$url" >>"$HOME/.config/mpv/mpv_history"

command mpv "$url"
