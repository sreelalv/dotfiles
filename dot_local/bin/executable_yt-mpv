#!/usr/bin/env bash

comment=""
if [[ "$1" = "--comment" || "$1" = "-c" ]]; then
  mpv_entry

  if ! mpv_entry="$(zenity --forms \
    --title='mpv' \
    --text='' \
    --add-entry='Name')"; then
    exit
  fi

  IFS='|' read -r comment <<<"$mpv_entry"
fi

url=$(~/.local/bin/getit)

if [[ -z "$url" ]]; then
  exit
fi

if [[ -n "$comment" ]]; then
  printf "%s|%s\n" "$comment" "$url" >>"$HOME/.config/mpv/mpv_history"
fi

mpv "$url"
